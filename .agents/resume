#!/usr/bin/env bash
# Runs every time an orb wakes. Nothing to reconnect: the app has no
# databases, secrets or tunnels, so just confirm dependencies are present.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

if [ ! -x node_modules/.bin/next ]; then
  echo "node_modules missing; run .agents/setup" >&2
  exit 1
fi
